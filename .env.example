# ─────────────────────────────────────────────────────────────────────────
# ANPR Traffic Intelligence Engine — environment configuration
# Copy to `.env` and adjust. Every value has a safe default, so an empty/absent
# .env runs the full "runs anywhere" demo (SQLite + in-memory cache + simulator).
# Environment variables always override values in backend/config/*.yaml.
# ─────────────────────────────────────────────────────────────────────────

# ---- Database --------------------------------------------------------------
# Default: a local SQLite file (zero setup, WAL mode for concurrent read/write).
DATABASE_URL=sqlite:///./anpr_traffic.db
# Production (PostgreSQL) — requires psycopg2-binary (requirements-optional.txt):
# DATABASE_URL=postgresql+psycopg2://anpr:CHANGE_ME@localhost:5432/anpr_traffic

# ---- Cache / live state ----------------------------------------------------
# "memory" (default, in-process) or "redis".
CACHE_BACKEND=memory
# Used only when CACHE_BACKEND=redis (requires the redis package):
REDIS_URL=redis://localhost:6379/0

# ---- Simulation ------------------------------------------------------------
# The background traffic simulator generates synthetic multi-camera data so the
# system is live with no real cameras. Set SIM_ENABLED=0 to disable it.
SIM_ENABLED=1
# Deterministic seed — same seed reproduces the same traffic/violations.
SIM_SEED=42

# ─────────────────────────────────────────────────────────────────────────
# Security. Defaults are safe for a local demo on a trusted machine. Set the
# starred (*) ones before putting the API on a network you do not control —
# scripts/host-public.ps1 sets ANPR_API_KEY for you when it opens a tunnel.
# ─────────────────────────────────────────────────────────────────────────

# * Write authorisation. When set, POST /api/violations/{id}/resolve requires
#   this value in an `X-API-Key` header (the dashboard asks for it once and
#   remembers it). Empty means writes are unauthenticated.
#   Generate one:  python -c "import secrets;print(secrets.token_urlsafe(24))"
ANPR_API_KEY=

# Refuse every mutation regardless of credentials. The safest way to publish a
# read-only demo link.
ANPR_READ_ONLY=0

# Cross-origin allowlist, comma-separated (e.g. https://ops.example.gov).
# Empty = localhost dev origins only, which is all the bundled dashboard needs
# because it is served by this same app. "*" allows any origin and forces
# credentials off — never combine a wildcard with cookies.
ALLOWED_ORIGINS=

# Accepted Host headers, comma-separated. Empty disables the check.
# e.g. ALLOWED_HOSTS=anpr.example.gov,localhost,127.0.0.1
ALLOWED_HOSTS=

# Per-IP request budgets for /api (sliding 60s window). The lower "heavy"
# budget applies to exports and report aggregations.
RATE_LIMIT_ENABLED=1
RATE_LIMIT_PER_MIN=240
RATE_LIMIT_HEAVY_PER_MIN=30

# Concurrent WebSocket ceiling. Every socket pushes a full snapshot every 2s.
WS_MAX_CONNECTIONS=64

# Content-Security-Policy for the served dashboard. Set CSP_ENABLED=0 to drop
# the header, or CSP=<policy> to replace it wholesale.
CSP_ENABLED=1

# Serve /docs, /redoc and /openapi.json. Set to 0 in a public deployment so the
# schema does not advertise the write endpoint.
ENABLE_DOCS=1

# ---- docker-compose only ---------------------------------------------------
# Compose refuses to start without these; there is no guessable fallback.
POSTGRES_USER=anpr
POSTGRES_PASSWORD=
POSTGRES_DB=anpr_traffic
REDIS_PASSWORD=
